# Marfeel (tráfico/audiencia — reemplaza a GA4)
# El password se fija con "Forgot your password" en el login de Marfeel.
MARFEEL_EMAIL=pdigitalrpp@gmail.com
MARFEEL_PASSWORD=xxxxxxxxxxxxxxxx

# Google Search Console (posicionamiento SEO)
GSC_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# SerpAPI
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxx

# Google Gemini (capa LLM: categorización, reescritura de títulos/metas)
# Key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# OpenRouter (capa LLM, proveedor PREFERIDO desde 2026-07-10 — reemplaza a
# Bedrock, que la cuenta AWS del usuario no puede invocar). Key en
# https://openrouter.ai/keys. Modelo default: tencent/hy3:free (gratis en
# OpenRouter, ver comentario en agent/config.py sobre vigencia de la promo).
# Proveedor LLM preferido (2026-08-21+). Sin esta key el agente cae a
# OpenRouter, luego Bedrock, luego Gemini, y al final a reglas.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Familia GPT-5.6, los tres de razonamiento: sol $5/$30, terra $2/$12,
# luna $0.20/$1.20 por millon (entrada/salida). Default luna: el costo lo
# domina categorizar titulares de competencia (~12 de las ~17 llamadas por
# corrida) y esa tarea no necesita mas cabeza. Ver config.py.
OPENAI_MODEL=gpt-5.6-luna
# none|low|medium|high|xhigh|max. En low: los tokens de razonamiento se
# facturan como salida y salen del mismo presupuesto que la respuesta.
OPENAI_REASONING_EFFORT=low
# Fallback. Opcional: fuerza uno concreto ignorando el orden
# (openai | openrouter | bedrock | gemini).
LLM_PROVIDER=
OPENROUTER_API_KEY=xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openrouter/free

# Supabase
SUPABASE_URL=https://tfrnpjbvxulswvqtosoq.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Configuración regional
TZ=America/Lima
GOOGLE_TRENDS_GEO=PE
